{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repopact.s2-materialization.v1",
  "title": "RepoPact S2 deterministic materialization manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "task_set_registration_version", "bed_id", "upstream", "local_asset_path", "source_schema", "acquisition", "selected_task_ids", "selected_task_count", "selected_tasks", "base_commit_preflight", "projections", "fingerprint_basis", "fingerprint"],
  "properties": {
    "schema_version": {"const": "repopact.s2-materialization.v1"},
    "study_id": {"const": "S2"},
    "task_set_registration_version": {"type": "string", "minLength": 1},
    "bed_id": {"type": "string", "minLength": 1},
    "upstream": {
      "type": "object", "additionalProperties": false,
      "required": ["locator", "revision", "asset_relative_path", "asset_size_bytes", "asset_sha256", "git_blob_sha", "source_format"],
      "properties": {
        "locator": {"type": "string", "pattern": "^https://"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "asset_relative_path": {"type": "string", "minLength": 1},
        "asset_size_bytes": {"type": "integer", "minimum": 1},
        "asset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "git_blob_sha": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
        "source_format": {"enum": ["parquet", "arrow-stream"]}
      }
    },
    "local_asset_path": {"type": "string", "minLength": 1},
    "source_schema": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "acquisition": {
      "type": "object", "additionalProperties": false,
      "required": ["timestamp", "materializer_version", "classification"],
      "properties": {
        "timestamp": {"type": "string", "format": "date-time"},
        "materializer_version": {"type": "string", "minLength": 1},
        "classification": {"const": "deterministic/non-empirical"}
      }
    },
    "selected_task_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "selected_task_count": {"type": "integer", "minimum": 1},
    "selected_tasks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["task_id", "record_sha256", "repository", "base_commit", "model_projection", "evaluation_projection"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "repository": {"type": "string", "pattern": "^[^/\\\\]+/[^/\\\\]+$"},
          "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "model_projection": {"type": "string", "minLength": 1},
          "evaluation_projection": {"type": "string", "minLength": 1}
        }
      }
    },
    "base_commit_preflight": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["task_id", "repository", "base_commit", "status", "method"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "pattern": "^[^/\\\\]+/[^/\\\\]+$"},
          "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "status": {"const": "resolved"},
          "method": {"const": "github-commit-api"}
        }
      }
    },
    "projections": {
      "type": "object", "additionalProperties": false,
      "required": ["model_facing_directory", "evaluation_directory", "model_facing_fields", "gold_solution_fields_excluded_from_model_projection"],
      "properties": {
        "model_facing_directory": {"type": "string", "minLength": 1},
        "evaluation_directory": {"type": "string", "minLength": 1},
        "model_facing_fields": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "gold_solution_fields_excluded_from_model_projection": {"const": true}
      }
    },
    "fingerprint_basis": {"type": "object"},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
